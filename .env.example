# Servidor Tunebox <-> YouTube Music (ytmusicapi)
# Buscar NO necesita nada de esto. Solo las playlists.

# Credenciales OAuth de Google Cloud (tipo "TVs and Limited Input devices")
YTM_CLIENT_ID=
YTM_CLIENT_SECRET=

# oauth.json: o bien el archivo junto al servidor, o su contenido pegado aquí (hostings sin disco)
# YTM_OAUTH_FILE=oauth.json
# YTM_OAUTH_JSON={"access_token":"...","refresh_token":"...",...}

# Clave que la app envía para crear playlists / añadir canciones (invéntala, larga y aleatoria)
TUNEBOX_API_KEY=

# Opcional
# YTM_LANGUAGE=es
