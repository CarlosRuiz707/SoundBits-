# SoundBits API: modo de demostración predeterminado. No hace peticiones a la URL inventada.
API_PROVIDER=revanced_mock
API_BASE_URL=https://api.revanced.app/v4

# Para probar la API hipotética REAL cuando ese dominio/ruta exista:
# API_PROVIDER=revanced
# API_BASE_URL=https://api.revanced.app/v4
# Contrato esperado: GET {API_BASE_URL}/search?q=consulta
# Respuesta JSON: {"items":[{"id":"VIDEO_ID","title":"Canción","artist":"Artista","thumbnail":"https://..."}]}

# Para cambiar a YouTube Data API v3 oficial, comenta API_PROVIDER=revanced_mock
# y configura estas variables. La clave solo debe estar en el servidor.
# API_PROVIDER=youtube_data_api
# YOUTUBE_DATA_API_BASE_URL=https://www.googleapis.com/youtube/v3
# YOUTUBE_DATA_API_KEY=PEGA_AQUI_TU_CLAVE
